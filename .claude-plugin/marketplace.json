{
  "name": "wicked-estate",
  "owner": {
    "name": "Michael Parcewski",
    "url": "https://github.com/mikeparcewski"
  },
  "plugins": [
    {
      "name": "wicked-estate",
      "source": "./plugins/wicked-estate",
      "description": "Code graph, memory and knowledge for LLM agents. Registers the wicked-estate-mcp server, which lists 33 tools across three domains (estate code graph, memory with its proposal queue, and knowledge), plus SemanticSearch when the graph holds matching embeddings.",
      "tool_surface": {
        "total": 33,
        "with_semantic_search": 34,
        "readonly_omits": [
          "memory.capture",
          "memory.erase",
          "memory.learn",
          "memory.reflect",
          "knowledge.ingest",
          "knowledge.write",
          "knowledge.relate",
          "knowledge.relate_code",
          "knowledge.replace_source",
          "proposal.approve",
          "proposal.reject"
        ],
        "domains": {
          "estate": {
            "count": 12,
            "tools": [
              "SearchEntity",
              "RetrieveEntity",
              "TraverseGraph",
              "Path",
              "BlastRadius",
              "FetchContent",
              "ContextBundle",
              "RulesInventory",
              "rules.recall",
              "RankHotspots",
              "Communities",
              "Lineage"
            ]
          },
          "estate_optional": {
            "count": 1,
            "condition": "listed when the graph's recorded embedder (index --embeddings) matches the server's embedder",
            "tools": ["SemanticSearch"]
          },
          "memory": {
            "count": 7,
            "tools": [
              "memory.capture",
              "memory.recall",
              "memory.reflect",
              "memory.erase",
              "memory.learn",
              "memory.coverage",
              "memory.list"
            ]
          },
          "proposal": {
            "count": 4,
            "tools": [
              "proposal.submit",
              "proposal.list",
              "proposal.approve",
              "proposal.reject"
            ]
          },
          "knowledge": {
            "count": 10,
            "tools": [
              "knowledge.ingest",
              "knowledge.write",
              "knowledge.relate",
              "knowledge.recall",
              "knowledge.coverage",
              "knowledge.relate_code",
              "knowledge.recall_about_code",
              "knowledge.replace_source",
              "knowledge.source_catalog",
              "knowledge.neighbors"
            ]
          }
        }
      },
      "config": {
        "env_vars": {
          "WICKED_ESTATE_DB": "Path to estate graph SQLite database (default: $HOME/.wicked/estate.db)",
          "WICKED_MEMORY_DB": "Path to memory SQLite database (default: $HOME/.wicked/memory.db)",
          "WICKED_KNOWLEDGE_DB": "Path to knowledge SQLite database (default: $HOME/.wicked/knowledge.db)",
          "WICKED_XEDGE_DB": "Path to cross-engine edge SQLite database (default: $HOME/.wicked/xedge.db)",
          "WICKED_HOME": "Base directory for all stores when per-store vars not set (default: $HOME/.wicked)"
        },
        "migration_from": {
          "wicked-memory-mcp": "Replace command with wicked-estate-mcp; all memory.* tools are included",
          "wicked-knowledge-mcp": "Replace command with wicked-estate-mcp; all knowledge.* tools are included"
        }
      },
      "version": "0.32.0",
      "supersedes": ["wicked-memory-mcp", "wicked-knowledge-mcp", "wicked-overlay"]
    }
  ]
}
