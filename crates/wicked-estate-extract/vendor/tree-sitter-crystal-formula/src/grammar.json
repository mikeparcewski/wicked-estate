          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_arg_list"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "_arg_list": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
