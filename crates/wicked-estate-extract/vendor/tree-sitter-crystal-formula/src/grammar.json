          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "PATTERN",
              "value": "[bB][oO][oO][lL][eE][aA][nN][vV][aA][rR]"
            }
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "PATTERN",
              "value": "[dD][aA][tT][eE][vV][aA][rR]"
            }
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "PATTERN",
              "value": "[tT][iI][mM][eE][vV][aA][rR]"
            }
          }
        },
