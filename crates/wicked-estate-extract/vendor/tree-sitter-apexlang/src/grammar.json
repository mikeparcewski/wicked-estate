    "_fence_open": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "\\r?\\n"
          },
          {
            "type": "PATTERN",
            "value": "[ \\t]*"
          },
          {
            "type": "STRING",
            "value": "```"
          }
        ]
      }
    },
    "fence_language": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Za-z0-9_+#.-]+"
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z0-9_$][A-Za-z0-9_.$-]*"
    },
    "component_id": {
      "type": "PATTERN",
      "value": "[^\\s(){}:\"\\[\\]][^\\s()]*"
    },
    "reference": {
      "type": "PATTERN",
      "value": "@[^\\s]+"
    },
    "string": {
      "type": "PATTERN",
      "value": "\"([^\"\\\\\\r\\n]|\\\\.)*\""
    },
    "text": {
      "type": "PATTERN",
      "value": "[^\\s@\\[]([^\\r\\n]*[^\\s])?"
    },
    "word": {
      "type": "PATTERN",
      "value": "[^\\s@\"\\[\\]][^\\s\\]]*"
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -2,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "//"
                },
                {
                  "type": "PATTERN",
                  "value": "[^\\r\\n]*"
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "/*"
                },
                {
                  "type": "PATTERN",
                  "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
                },
                {
                  "type": "STRING",
                  "value": "/"
                }
              ]
            }
          ]
        }
      }
    },
    "_nl": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  },
  "extras": [
    {
