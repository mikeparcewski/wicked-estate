       IDENTIFICATION DIVISION.
       PROGRAM-ID. PAYCALC.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PAY-FILE ASSIGN TO PAYIN.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY PAYREC.
       01 WS-RATEPGM PIC X(8) VALUE 'RATEPGM'.
       PROCEDURE DIVISION.
       MAIN-PARA.
           MOVE 1 TO PAY-ID.
           CALL WS-RATEPGM USING PAY-REC.
           EXEC CICS LINK PROGRAM('STUB') COMMAREA(PAY-REC) END-EXEC.
           EXEC CICS SEND MAP('PAYMAP') MAPSET('PAYSET') END-EXEC.
           EXEC CICS RECEIVE MAP('PAYMAP') MAPSET('PAYSET') END-EXEC.
           EXEC SQL SELECT AMT INTO :PAY-ID FROM PAYHIST END-EXEC.
           EXEC SQL UPDATE PAYHIST SET AMT = 0 WHERE ID = :PAY-ID END-EXEC.
           GOBACK.
