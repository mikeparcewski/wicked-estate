---
import Base from "wicked-web/layouts/Base.astro";
import Topbar from "wicked-web/components/Topbar.astro";
import Footer from "wicked-web/components/Footer.astro";
import SameGarden from "wicked-web/components/SameGarden.astro";
import "../styles/global.css";
import Content, { GetStarted } from "../components/Content.tsx";
---

<Base
  title="wicked-estate — code graph, memory, knowledge. One binary."
  description="The foundation of the wicked platform: the system of record for your codebase. One local-first MCP server — 23 tools across 3 domains — turns your repo into a queryable graph: blast-radius of change, injected edges grep never sees (ExtraEdge TOML rules), scoped memory with subtree recall/erase, hybrid RRF-fused knowledge retrieval. 102 wired tree-sitter languages, every edge stamped with confidence and provenance. SQLite by default, PostgreSQL for teams."
>
  <Topbar pkg="wicked-estate" repo="https://github.com/mikeparcewski/wicked-estate" />
  <main class="font-sans">
    <Content client:load />
    <div id="foundation">
      <SameGarden current="wicked-estate" />
    </div>
    <GetStarted client:load />
  </main>
  <Footer repo="https://github.com/mikeparcewski/wicked-estate" />
</Base>
