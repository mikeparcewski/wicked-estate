---
import Base from "wicked-web/layouts/Base.astro";
import Topbar from "wicked-web/components/Topbar.astro";
import Footer from "wicked-web/components/Footer.astro";
import SameGarden from "wicked-web/components/SameGarden.astro";
import "../styles/global.css";
import Content, { GetStarted } from "../components/Content.tsx";
---

<Base
  title="wicked-estate — code graph, memory, knowledge. One binary."
  description="What your agents know about your system. One local-first MCP server — 30 tools across 3 domains — turns your repo into a queryable graph: blast-radius of change, injected edges grep never sees (ExtraEdge TOML rules), memory (what happened, what you told it) with subtree recall/erase, knowledge learned from your code and docs with hybrid RRF-fused retrieval, and governed knowledge where agents propose and humans promote. 114 languages, every edge stamped with confidence and provenance. Local-first on SQLite, with a Postgres store backend for teams."
>
  <Topbar pkg="wicked-estate" repo="https://github.com/mikeparcewski/wicked-estate" />
  <main class="font-sans">
    <Content client:load />
    <div id="foundation">
      <SameGarden current="wicked-estate" />
    </div>
    <GetStarted client:load />
  </main>
  <Footer repo="https://github.com/mikeparcewski/wicked-estate" />
</Base>
