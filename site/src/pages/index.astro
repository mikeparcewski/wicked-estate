---
import Base from "wicked-web/layouts/Base.astro";
import Topbar from "wicked-web/components/Topbar.astro";
import Footer from "wicked-web/components/Footer.astro";
import SameGarden from "wicked-web/components/SameGarden.astro";
import "../styles/global.css";
import Content, { GetStarted } from "../components/Content.tsx";

// The scene rail: one dot per frame, in page order (scenes.ts marks the current one).
const SCENES = [
  { id: "hero", label: "What it is" },
  { id: "stores", label: "Three stores" },
  { id: "provenance", label: "Edges and confidence" },
  { id: "toolface", label: "What agents can call" },
  { id: "storage", label: "Local by default" },
  { id: "foundation", label: "The family" },
  { id: "get-started", label: "Get started" },
];
---

<Base
  title="wicked-estate — what your agents know about your system"
  description="What your agents know about your system. Your code as a graph, including the edges grep never sees; memory of what happened and what you told it; and knowledge read from your docs, cited. A local CLI and MCP server with a catalog of 30 standard MCP tools. Every edge carries its confidence and provenance. Local SQLite by default; a shared PostgreSQL code graph for a team is an optional CLI build."
>
  <!-- Motion is opt-in by the visitor's setting, decided before first paint so the hero's
       one-shot intro never flashes its end state first. Reduced motion: no class, end states only. -->
  <script is:inline>
    try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion-ok'); } catch (e) {}
  </script>
  <Topbar pkg="wicked-estate" repo="https://github.com/mikeparcewski/wicked-estate" />
  <main class="font-sans">
    <Content client:load />
    <div id="foundation">
      <SameGarden current="wicked-estate" />
    </div>
    <GetStarted client:load />
  </main>
  <nav class="scene-rail" aria-label="Scenes">
    {SCENES.map((s) => (
      <a href={`#${s.id}`} data-rail={s.id} aria-label={s.label} title={s.label}>
        <span class="rail-dot" aria-hidden="true"></span>
        <span class="rail-label" aria-hidden="true">{s.label}</span>
      </a>
    ))}
  </nav>
  <Footer repo="https://github.com/mikeparcewski/wicked-estate" />
  <script>
    import "../scripts/scenes.ts";
  </script>
</Base>
