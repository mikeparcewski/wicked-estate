---
import Base from "wicked-web/layouts/Base.astro";
import Topbar from "wicked-web/components/Topbar.astro";
import Footer from "wicked-web/components/Footer.astro";
import SameGarden from "wicked-web/components/SameGarden.astro";
import "../styles/global.css";
import Content, { GetStarted } from "../components/Content.tsx";

// The page's spine (the same thread and beat track as wicked-crew's): what estate is, then the frames
// that show it, each named from its own kicker or heading. The family map and Get started are not beats.
const BEATS = [
  { id: "hero", name: "Estate" },
  { id: "stores", name: "Stores" },
  { id: "provenance", name: "Edges" },
  { id: "toolface", name: "Call" },
  { id: "storage", name: "Local" },
];
---

<Base
  title="wicked-estate — what your agents know about your system"
  description="What your agents know about your system. Your code as a graph, including the edges grep never sees; memory of what happened and what you told it; and knowledge read from your docs and the structure of your data sources, cited. A local CLI and MCP server with a catalog of 33 standard MCP tools. Every edge carries its confidence and provenance. Local SQLite by default; a shared PostgreSQL code graph for a team is an optional CLI build."
>
  <!-- Motion is opt-in by the visitor's setting, decided before first paint so the hero's
       one-shot intro never flashes its end state first, and kept in step with that setting if it
       changes during the visit. Reduced motion: no class, end states only. -->
  <script is:inline>
    try {
      var rm = matchMedia('(prefers-reduced-motion: reduce)');
      var sync = function () { document.documentElement.classList.toggle('motion-ok', !rm.matches); };
      sync();
      if (rm.addEventListener) rm.addEventListener('change', sync);
    } catch (e) {}
  </script>
  <Topbar pkg="wicked-estate" repo="https://github.com/mikeparcewski/wicked-estate" />
  <!-- The spine, at 1024px wide and up: the page's beats as one thread under the topbar, filling as
       each beat arrives (decoration; the beat track says it in words). -->
  <div class="beat-thread" data-beat-thread aria-hidden="true">{BEATS.map((b) => <i data-beat-thread-seg={b.id}><b></b></i>)}</div>
  <!-- The spine: the page's beats, in the right gutter (1400px wide and up, where the gutter holds it). -->
  <nav class="beats" data-beats data-beats-content=".scene-in" aria-label="Estate, beat by beat">
    <ol>
      {BEATS.map((b, i) => (
        <li><a href={`#${b.id}`} data-beat-link={b.id}><span class="beats-l">{b.name}</span><span class="beats-dot" aria-hidden="true"></span><span class="sr-only">{`, beat ${i + 1} of ${BEATS.length}`}</span></a></li>
      ))}
    </ol>
  </nav>
  <main class="font-sans">
    <Content client:load />
    <div id="foundation">
      <SameGarden current="wicked-estate" />
    </div>
    <GetStarted client:load />
  </main>
  <Footer repo="https://github.com/mikeparcewski/wicked-estate" />
  <script>
    import "../scripts/scenes.ts";
    import "../scripts/beats.js";
  </script>
</Base>
