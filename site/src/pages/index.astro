---
import Base from "wicked-web/layouts/Base.astro";
import Topbar from "wicked-web/components/Topbar.astro";
import Footer from "wicked-web/components/Footer.astro";
import "../styles/global.css";
import Content from "../components/Content.tsx";
---

<Base
  title="wicked-estate — the substrate every agent queries"
  description="One local-first MCP server as five stacked strata — code graph, memory, knowledge, requirements↔code, and typed annotations — all keyed to one symbol identity, every edge stamped with confidence and provenance. SQLite by default, PostgreSQL for teams."
>
  <Topbar pkg="wicked-estate" repo="https://github.com/mikeparcewski/wicked-estate" />
  <Content client:load />
  <Footer repo="https://github.com/mikeparcewski/wicked-estate" />
</Base>
